# Copy to .env — never commit .env

# --- tier 4 (Dune): historical backfill only. Without it, tiers 1-3 still run.
DUNE_API_KEY=

# --- tier 1 (CoinGecko): optional. A demo key raises the free-tier rate limit.
COINGECKO_API_KEY=

# --- tier 2 (contract reads): comma-separated overrides of the public RPC fallback lists.
#     Leave blank to use the defaults in config.DEFAULT_RPC.
RPC_ETHEREUM=
RPC_BSC=
RPC_BASE=
RPC_ARBITRUM=
RPC_OPTIMISM=
# --- ONE ALCHEMY KEY (Round G3): every Alchemy URL is built as https://<host>.g.alchemy.com/v2/<key>
#     from fetch.chain.ALCHEMY_HOSTS (eth, opt, arb, base, polygon, bnb, berachain, hyperliquid, plasma,
#     sonic, mantle, solana, tron, worldmobilechain — the networks enabled on the app). Paste the KEY,
#     not a URL: no "/", spaces, "<" or ">"; 16-64 characters. A malformed key stops the run at
#     startup; the key is never printed (check: python check_offline_items.py env_keys).
ALCHEMY_API_KEY=
# --- per-chain overrides, still honoured: <CHAIN>_RPC_URL is tried FIRST (before the Alchemy URL
#     built from ALCHEMY_API_KEY), with the public list behind it; RPC_<CHAIN> above REPLACES the list.
#     Without ALCHEMY_API_KEY, the key inside any Alchemy <CHAIN>_RPC_URL is used for the other chains.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=

# --- block-explorer log APIs (event scans — Sky burns, buyback inflows, pool releases).
#     Explorers page logs by record count, so the RPC range cap does not apply.
#     Never logged: messages are scrubbed of both keys.
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# NearBlocks API v3 (NEAR tx_count and active_addresses). Sent as a Bearer header, never logged.
NEARBLOCKS_API_KEY=

# beaconcha.in ETH.Store (Ethereum consensus-layer issuance). Sent as an `apikey` header, never
# logged — see fetch/beaconchain.py for why that header name, not Authorization: Bearer.
BEACONCHAIN_API_KEY=

# --- flags
# Read contract addresses that have NOT been verified against the protocol's own docs.
# Off by default: unverified addresses are refused and listed in the Gap Report instead.
# Even with this on, every ERC-20 read still self-checks symbol() before accepting a value.
TOKEN_METRICS_ALLOW_UNVERIFIED=
# Re-pull Dune even for series the store already has history for (tier 4 is backfill-only).
TOKEN_METRICS_DUNE_ALWAYS=
# Use a different registry file instead of sources.yaml.
TOKEN_METRICS_SOURCES=
